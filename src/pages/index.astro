---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import schoolPhoto from '../assets/school/school.jpg';
import EmptyState from '../components/EmptyState.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Statistics from '../components/Statistics.astro';
import DepartmentCard from '../components/DepartmentCard.astro';
import LeadershipCard from '../components/LeadershipCard.astro';
import { site, vision, missions, activities, departments, advisors, coreLeadership } from '../content/site';
const aspirationsOpen = import.meta.env.PUBLIC_ASPIRATIONS_ENABLED === 'true' && Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---
<Base>
  <section class="hero school-hero container" id="hero" data-section="01" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div data-motion="hero"><SectionLabel number="01" label={`${site.name} · ${site.term}`} /></div>
      <h1 id="hero-title" data-motion="hero" data-delay="90">Vimsati<br /><span>Natta Darsa.</span></h1>
      <p class="hero-tagline" data-motion="hero" data-delay="150">Suara kita. Langkah bersama.</p>
      <p class="hero-description" data-motion="hero" data-delay="210">Ruang siswa SMK Diponegoro 01 untuk berkarya, mengikuti kegiatan, dan menyampaikan aspirasi. Bersama, kita membuat sekolah lebih baik.</p>
      <div class="button-row" data-motion="hero" data-delay="270">
        <a class="button" href="/anggota">Kenali pengurus <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/aspirasi">Sampaikan aspirasi <span aria-hidden="true">↗</span></a>
      </div>
      <a class="hero-scroll text-link" href="#statistik" data-motion="hero" data-delay="340"><span class="scroll-indicator" aria-hidden="true">↓</span> Kepengurusan dalam angka</a>
    </div>
    <figure class="school-hero-photo" data-motion="hero" data-delay="140">
      <Image src={schoolPhoto} alt="Gedung dan halaman kompleks sekolah Diponegoro di Jakarta, tempat SMK Diponegoro 01 berada" width={schoolPhoto.width} height={schoolPhoto.height} widths={[480, 720, 1000]} sizes="(max-width: 760px) 92vw, 52vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
      <span data-cms-term="" class="school-photo-term" aria-hidden="true">{site.term}</span>
      <figcaption><span>Sekolah kita.<strong>SMK Diponegoro 01</strong></span><span class="school-photo-location">Jakarta</span></figcaption>
    </figure>
  </section>
  <div class="container school-strip"><span>Organisasi Siswa Intra Sekolah</span><span>{site.cabinetName} · {site.term}</span></div>

  <Statistics />

  <section class="section container" id="tentang" data-section="03" aria-labelledby="about-title">
    <div class="section-heading" data-motion="reveal"><SectionLabel number="03" label="Tentang kami" /><h2 id="about-title">Dari siswa,<br />untuk sekolah.</h2></div>
    <div class="section-body" data-motion="reveal" data-delay="100"><p class="lead">OSIS menjadi wadah bagi siswa untuk belajar berorganisasi, bekerja sama, dan ikut berperan dalam kehidupan sekolah.</p><p>Di sini, kamu bisa mengenal pengurus, melihat program kerja, dan mengikuti kegiatan OSIS SMK Diponegoro 01 Jakarta.</p><a class="text-link" href="/anggota"><span data-cms-term="Pengurus ">Pengurus {site.term}</span> <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="muted-section" id="visi-misi" data-section="04" aria-labelledby="vision-title">
    <div class="container section">
      <div class="section-heading" data-motion="reveal"><SectionLabel number="04" label="Arah bersama" /><h2 id="vision-title">Visi & misi.</h2></div>
      <div class="section-body vision-grid" data-motion="reveal" data-delay="100">
        <div><h3>Visi</h3><p data-cms-vision>{vision ?? 'Visi kepengurusan 2026/2027 akan diumumkan setelah disahkan.'}</p></div>
        <div><h3>Misi</h3><div class="mission-copy" data-cms-missions>{missions.map(mission => <p>{mission}</p>)}</div></div>
      </div>
    </div>
  </section>

  <section class="department-home container" id="kepengurusan" data-section="05" aria-labelledby="leadership-preview-title">
    <header class="department-directory-heading" data-motion="reveal">
      <div><SectionLabel number="05" label="Kepengurusan" /><h2 id="leadership-preview-title">Orang-orang<br />di balik OSIS.</h2></div>
      <div><p>Guru pembina, pengurus inti, dan sepuluh seksi bidang yang bekerja bersama untuk Dipo.</p></div>
    </header>
    <div class="leadership-group" aria-labelledby="advisor-preview-heading">
      <div class="leadership-group-heading" data-motion="reveal"><div><h3 id="advisor-preview-heading">Guru pembina</h3><p>Mendampingi langkah OSIS.</p></div><a class="text-link" href="/anggota/pembina">Kenali tim pembina <span aria-hidden="true">↗</span></a></div>
      <div class="advisor-grid" data-cms-people="advisor" data-cms-heading="h4">{advisors.map(person => <LeadershipCard person={person} headingLevel="h4" />)}</div>
    </div>
    <div class="leadership-group" aria-labelledby="core-preview-heading">
      <div class="leadership-group-heading" data-motion="reveal"><div><h3 id="core-preview-heading">Pengurus inti OSIS</h3><p>Empat peran dalam satu tim.</p></div><a class="text-link" href="/anggota">Kenali pengurus inti <span aria-hidden="true">↗</span></a></div>
      <div class="leadership-grid" data-cms-people="core" data-cms-heading="h4">{coreLeadership.map((person, index) => <LeadershipCard person={person} headingLevel="h4" delay={index * 60} />)}</div>
    </div>
    <span id="sekbid" aria-hidden="true"></span>
    <div class="leadership-group" id="seksi-bidang" aria-labelledby="department-preview-title">
      <div class="leadership-group-heading" data-motion="reveal"><div><h3 id="department-preview-title">Seksi bidang</h3><p>Sepuluh bidang, banyak ruang untuk berkarya.</p></div><a class="text-link" href="/anggota/seksi-bidang">Kenali semua 10 bidang <span aria-hidden="true">↗</span></a></div>
      <div class="department-grid department-preview-grid" data-cms-departments data-cms-limit="4" data-cms-heading="h4">{departments.slice(0, 4).map((department, index) => <DepartmentCard department={department} preview headingLevel="h4" delay={index * 60} />)}</div>
    </div>
  </section>

  <section class="section container bordered-section" id="kegiatan" data-section="06" aria-labelledby="activity-title">
    <div class="section-heading" data-motion="reveal"><SectionLabel number="06" label="Kabar dari OSIS" /><h2 id="activity-title">Agenda & rundown.</h2></div>
    <div class="section-body" data-cms-events data-motion="reveal" data-delay="100">{activities.length > 0 ? <div class="content-list">{activities.map(activity => <article><time datetime={activity.date}>{new Intl.DateTimeFormat('id-ID', { dateStyle: 'long', timeZone: 'Asia/Jakarta' }).format(new Date(activity.date))}</time><h3>{activity.title}</h3><p>{activity.description}</p></article>)}</div> : <EmptyState title="Agenda kegiatan segera hadir" description="Jadwal dan rundown kegiatan OSIS akan dibagikan di sini setelah diumumkan." />}</div>
  </section>

  <section class="aspiration-banner container" data-section="07" data-motion="reveal" aria-labelledby="aspiration-title">
    <div><SectionLabel number="07" label="Ruang aspirasi" /><h2 id="aspiration-title">Ada ide untuk Dipo?</h2><p>{aspirationsOpen ? 'Setiap masukan punya tempat. Sampaikan ide dan saranmu untuk sekolah dan OSIS.' : 'Setiap masukan punya tempat. Ruang aspirasi siswa segera hadir.'}</p></div>
    <a class="button button-light" href="/aspirasi">{aspirationsOpen ? 'Sampaikan aspirasi' : 'Lihat ruang aspirasi'} <span aria-hidden="true">↗</span></a>
  </section>
</Base>
