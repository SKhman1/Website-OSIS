---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Statistics from '../components/Statistics.astro';
import { site, vision, missions, programs, activities } from '../content/site';
---
<Base>
  <section class="hero container" id="hero" data-section="01" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div data-motion="hero"><SectionLabel number="01" label={`Kepengurusan ${site.term}`} /></div>
      <h1 id="hero-title" data-motion="hero" data-delay="90">Suara kita.<br />Langkah bersama.</h1>
      <p class="hero-description" data-motion="hero" data-delay="180">Ruang untuk mengenal OSIS, mengikuti kegiatan sekolah, dan menyampaikan ide untuk Dipo yang lebih baik.</p>
      <div class="button-row" data-motion="hero" data-delay="270">
        <a class="button" href="/anggota">Kenali pengurus <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#tentang">Tentang OSIS <span aria-hidden="true">↓</span></a>
      </div>
      <a class="hero-scroll text-link" href="#statistik" data-motion="hero" data-delay="360"><span class="scroll-indicator" aria-hidden="true">↓</span> Dipo dalam angka</a>
    </div>
    <div class="identity-panel" data-motion="hero" data-delay="160" aria-label="OSIS SMK Diponegoro 1 Jakarta, periode 2026/2027">
      <span class="identity-orbit" aria-hidden="true"></span>
      <div class="identity-top"><span>SMK Diponegoro 1</span><span>Jakarta</span></div>
      <div class="identity-type" aria-hidden="true">O<span class="identity-s">S</span><br /><span class="identity-i">I</span>S<span class="identity-period">.</span></div>
      <div class="identity-bottom"><span>Berkarakter<br />Berkarya<br />Berteknologi</span><span class="identity-year">26 / 27</span></div>
    </div>
  </section>
  <div class="container school-strip"><span>Organisasi Siswa Intra Sekolah</span><span>{site.school}</span></div>

  <Statistics />

  <section class="section container" id="tentang" data-section="03" aria-labelledby="about-title">
    <div class="section-heading" data-motion="reveal"><SectionLabel number="03" label="Tentang kami" /><h2 id="about-title">Dari siswa,<br />untuk sekolah.</h2></div>
    <div class="section-body" data-motion="reveal" data-delay="100"><p class="lead">OSIS menjadi wadah bagi siswa untuk belajar berorganisasi, bekerja sama, dan ikut berperan dalam kehidupan sekolah.</p><p>Di sini, kamu bisa mengenal pengurus, melihat program kerja, dan mengikuti kegiatan OSIS SMK Diponegoro 1 Jakarta.</p><a class="text-link" href="/anggota">Pengurus {site.term} <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="muted-section" id="visi-misi" data-section="04" aria-labelledby="vision-title">
    <div class="container section">
      <div class="section-heading" data-motion="reveal"><SectionLabel number="04" label="Arah bersama" /><h2 id="vision-title">Visi & misi.</h2></div>
      <div class="section-body vision-grid" data-motion="reveal" data-delay="100">
        <div><h3>Visi</h3><p>{vision ?? 'Visi kepengurusan 2026/2027 akan diumumkan setelah disahkan.'}</p></div>
        <div><h3>Misi</h3>{missions.length > 0 ? <ol>{missions.map(mission => <li>{mission}</li>)}</ol> : <p>Misi kepengurusan 2026/2027 sedang disiapkan.</p>}</div>
      </div>
    </div>
  </section>

  <section class="section container" id="program" data-section="05" aria-labelledby="program-title">
    <div class="section-heading" data-motion="reveal"><SectionLabel number="05" label="Rencana kerja" /><h2 id="program-title">Ide menjadi aksi.</h2></div>
    <div class="section-body" data-motion="reveal" data-delay="100">{programs.length > 0 ? <div class="content-list">{programs.map(program => <article><h3>{program.title}</h3><p>{program.description}</p></article>)}</div> : <EmptyState title="Program kerja segera hadir" description="Rencana kegiatan akan tersedia setelah disahkan oleh kepengurusan." />}</div>
  </section>

  <section class="section container bordered-section" id="kegiatan" data-section="06" aria-labelledby="activity-title">
    <div class="section-heading" data-motion="reveal"><SectionLabel number="06" label="Kabar dari OSIS" /><h2 id="activity-title">Cerita & kegiatan.</h2></div>
    <div class="section-body" data-motion="reveal" data-delay="100">{activities.length > 0 ? <div class="content-list">{activities.map(activity => <article><time datetime={activity.date}>{new Intl.DateTimeFormat('id-ID', { dateStyle: 'long', timeZone: 'Asia/Jakarta' }).format(new Date(activity.date))}</time><h3>{activity.title}</h3><p>{activity.description}</p></article>)}</div> : <EmptyState title="Cerita pertama sedang disiapkan" description="Agenda dan dokumentasi kegiatan OSIS akan dibagikan di sini." />}</div>
  </section>

  <section class="aspiration-banner container" data-section="07" data-motion="reveal" aria-labelledby="aspiration-title">
    <div><SectionLabel number="07" label="Ruang aspirasi" /><h2 id="aspiration-title">Ada ide untuk Dipo?</h2><p>Setiap masukan punya tempat. Ruang aspirasi siswa segera hadir.</p></div>
    <a class="button button-light" href="/aspirasi">Lihat ruang aspirasi <span aria-hidden="true">↗</span></a>
  </section>
</Base>
