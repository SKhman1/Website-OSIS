---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import LeadershipCard from '../../components/LeadershipCard.astro';
import { site, advisors } from '../../content/site';
---
<Base title="Guru pembina OSIS" description={`Daftar guru pembina ${site.name} periode ${site.term}.`}>
  <div class="container page-content">
    <a class="text-link back-link" href="/#kepengurusan">← Kepengurusan di beranda</a>
    <section class="page-heading" data-section="01" aria-labelledby="advisors-title">
      <div data-motion="hero"><SectionLabel number="01" label={`Guru pembina · ${site.term}`} /></div>
      <h1 id="advisors-title" data-motion="hero" data-delay="90">Mendampingi<br />langkah OSIS.</h1>
      <p data-motion="hero" data-delay="180">Kenali guru pembina yang mendampingi pengurus dalam menjalankan kegiatan dan program kerja {site.name}.</p>
    </section>
    <section class="page-section" data-section="02" aria-labelledby="advisor-list-title">
      <header class="page-section-heading" data-motion="reveal"><SectionLabel number="02" label="Tim pembina" /><h2 id="advisor-list-title">Guru pembina OSIS.</h2><p class="roster-note">Daftar dan nama pembina akan dilengkapi setelah dikonfirmasi oleh sekolah. Foto yang ditampilkan masih berupa contoh.</p></header>
      <div class="advisor-grid" data-cms-people="advisor">{advisors.map((person, index) => <LeadershipCard person={person} delay={index % 4 * 60} />)}</div>
    </section>
    <section class="page-section member-contact" data-section="03" data-motion="reveal" aria-labelledby="advisor-core-title"><div><SectionLabel number="03" label="Pengurus inti" /><h2 id="advisor-core-title">Empat peran, satu tim.</h2></div><a class="button" href="/anggota">Kenali pengurus inti <span aria-hidden="true">↗</span></a></section>
  </div>
</Base>
