---
import MemberProfile from '../../components/MemberProfile.astro';
import { coreLeadership, members, type LeadershipMember } from '../../content/site';
export function getStaticPaths() {
  return [...coreLeadership, ...members].map(person => ({ params: { id: person.id }, props: { person } }));
}
interface Props { person: LeadershipMember; }
const { person } = Astro.props;
---
<MemberProfile person={person} />
