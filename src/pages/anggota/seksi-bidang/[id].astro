---
import Base from '../../../layouts/Base.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import ProfileHero from '../../../components/ProfileHero.astro';
import WorkProgramCard from '../../../components/WorkProgramCard.astro';
import WorkResults from '../../../components/WorkResults.astro';
import LeadershipCard from '../../../components/LeadershipCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { departments, profiles, site, type Department } from '../../../content/site';
import { programsFor } from '../../../content/work';
import purbayaPhoto from '../../../assets/placeholders/purbaya.png';
export function getStaticPaths() {
  return departments.map((department, index) => ({ params: { id: department.id }, props: { department, index } }));
}
interface Props { department: Department; index: number; }
const { department, index } = Astro.props;
const team = profiles.filter(person => department.memberIds.includes(person.id));
const work = programsFor(department.programIds);
const previous = departments[index - 1];
const next = departments[index + 1];
const photo = department.photo ?? purbayaPhoto;
---
<Base title={department.name} description={`Anggota, program kerja, dan hasil kerja ${department.name} OSIS ${site.school} periode ${site.term}.`}>
  <div class="container page-content profile-page">
    <nav class="profile-breadcrumb" aria-label="Lokasi halaman"><a href="/">Beranda</a><span aria-hidden="true">/</span><a href="/anggota/seksi-bidang">Seksi bidang</a><span aria-hidden="true">/</span><span aria-current="page">{department.number}</span></nav>
    <ProfileHero title={department.name} label={`Seksi bidang ${department.number} · ${site.term}`} description={department.description} photo={photo} photoAlt={department.photoAlt ?? `Foto sementara tim ${department.name}`} placeholder={department.photoIsPlaceholder ?? true} />
    <nav class="profile-index" aria-label="Bagian profil bidang"><a href="#anggota-bidang">Anggota <span aria-hidden="true">↘</span></a><a href="#program-kerja">Program kerja <span aria-hidden="true">↘</span></a><a href="#hasil-kerja">Hasil kerja <span aria-hidden="true">↘</span></a></nav>
    <section class="page-section profile-section" id="anggota-bidang" data-section="02" aria-labelledby="department-members-title"><header class="page-section-heading" data-motion="reveal"><SectionLabel number="02" label="Anggota bidang" /><h2 id="department-members-title">Tim yang bekerja bersama.</h2></header>{team.length ? <div class="leadership-grid">{team.map(person => <LeadershipCard person={person} />)}</div> : <EmptyState title="Anggota segera diperkenalkan" description="Nama pengurus dan anggota bidang akan ditampilkan setelah daftar kepengurusan tersedia." />}</section>
    <section class="page-section profile-section" id="program-kerja" data-section="03" aria-labelledby="department-program-title"><header class="page-section-heading" data-motion="reveal"><SectionLabel number="03" label="Rencana kerja" /><h2 id="department-program-title">Program kerja bidang.</h2></header>{work.length ? <div class="work-program-list">{work.map((program, programIndex) => <WorkProgramCard program={program} index={programIndex} />)}</div> : <EmptyState title="Program bidang segera hadir" description="Rencana kegiatan dan pelaksanaannya akan ditampilkan setelah informasi bidang tersedia." />}</section>
    <section class="page-section profile-section" id="hasil-kerja" data-section="04" aria-labelledby="department-results-title"><header class="page-section-heading" data-motion="reveal"><SectionLabel number="04" label="Hasil & dokumentasi" /><h2 id="department-results-title">Cerita dari kegiatan kami.</h2></header><WorkResults results={department.results} /></section>
    <nav class="profile-neighbors" aria-label="Bidang lainnya">{previous ? <a class="text-link" href={`/anggota/seksi-bidang/${previous.id}`}><span aria-hidden="true">←</span> {previous.name}</a> : <a class="text-link" href="/anggota/seksi-bidang">← Semua bidang</a>}{next ? <a class="text-link" href={`/anggota/seksi-bidang/${next.id}`}>{next.name} <span aria-hidden="true">→</span></a> : <a class="text-link" href="/anggota/seksi-bidang">Semua bidang <span aria-hidden="true">→</span></a>}</nav>
  </div>
</Base>
