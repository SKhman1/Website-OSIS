---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import LeadershipCard from '../components/LeadershipCard.astro';
import DepartmentCard from '../components/DepartmentCard.astro';
import { site, members, advisors, coreLeadership, departments } from '../content/site';
---
<Base title="Pengurus OSIS">
  <div class="container page-content">
    <a class="text-link back-link" href="/">← Beranda</a>
    <section class="page-heading" data-section="01" aria-labelledby="members-title"><div data-motion="hero"><SectionLabel number="01" label={`Periode ${site.term}`} /></div><h1 id="members-title" data-motion="hero" data-delay="90">Kenali pengurus.</h1><p data-motion="hero" data-delay="180">Guru pembina, pengurus inti, dan tim seksi bidang yang mendampingi kegiatan serta suara siswa Dipo.</p></section>
    <section class="page-section" data-section="02" aria-labelledby="advisors-title">
      <header class="page-section-heading" data-motion="reveal"><SectionLabel number="02" label="Guru pembina" /><h2 id="advisors-title">Mendampingi langkah OSIS.</h2><p class="roster-note">Nama pembina akan ditampilkan setelah dikonfirmasi oleh sekolah.</p></header>
      <div class="advisor-grid">{advisors.map(person => <LeadershipCard person={person} />)}</div>
    </section>
    <section class="page-section" data-section="03" aria-labelledby="core-title">
      <header class="page-section-heading" data-motion="reveal"><SectionLabel number="03" label="Pengurus inti OSIS" /><h2 id="core-title">Empat peran, satu tim.</h2></header>
      <div class="leadership-grid">{coreLeadership.map((person, index) => <LeadershipCard person={person} delay={index * 60} />)}</div>
      {members.length > 0 && <div class="member-grid approved-roster">{members.map(member => <article class="member-card fucknutcard">{member.photo && <img src={member.photo} alt={member.name} width="480" height="600" loading="lazy" />}<p>{member.department}</p><h3>{member.name}</h3><p>{member.role}</p></article>)}</div>}
    </section>
    <section class="page-section" data-section="04" aria-labelledby="department-title">
      <header class="department-directory-heading" data-motion="reveal"><div><SectionLabel number="04" label="Seksi bidang" /><h2 id="department-title">Tim di balik kegiatan.</h2></div><a class="text-link" href="/sekbid">Kenali semua 10 bidang <span aria-hidden="true">↗</span></a></header>
      <div class="department-grid department-preview-grid">{departments.slice(0, 4).map((department, index) => <DepartmentCard department={department} preview delay={index * 60} />)}</div>
    </section>
    <section class="page-section member-contact" data-section="05" data-motion="reveal" aria-labelledby="member-contact-title"><div><SectionLabel number="05" label="Tetap terhubung" /><h2 id="member-contact-title">Punya masukan untuk kami?</h2></div><a class="button" href="/aspirasi">Ruang aspirasi <span aria-hidden="true">↗</span></a></section>
  </div>
</Base>
