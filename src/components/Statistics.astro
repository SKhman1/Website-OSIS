---
import SectionLabel from './SectionLabel.astro';
import { statistics } from '../content/site';
---
<section class="statistics-section" id="statistik" data-section="02" aria-labelledby="statistics-title">
  <div class="container">
    <header class="statistics-heading" data-motion="reveal">
      <div><SectionLabel number="02" label="Dipo dalam angka" /><h2 id="statistics-title">Bersama, kita bergerak.</h2></div>
      <p>Kenali kepengurusan dan aktivitas OSIS lewat beberapa angka.</p>
    </header>
    <div class="statistics-grid" data-stats>
      {statistics.map((statistic, index) => (
        <article class="statistic fucknutcard" data-motion="reveal" data-delay={index * 80}>
          <p class="statistic-label">{statistic.label}</p>
          <p class="statistic-value">
            <span class="sr-only">{statistic.value === null ? `Contoh: ${statistic.previewValue}` : statistic.value}</span>
            <span data-counter data-value={statistic.value ?? statistic.previewValue} aria-hidden="true">{String(statistic.value ?? statistic.previewValue).padStart(2, '0')}</span>
            <span class="statistic-plus" aria-hidden="true">+</span>
          </p>
          <p class="statistic-description">{statistic.description}</p>
          {statistic.value === null && <span class="preview-badge">Angka contoh</span>}
        </article>
      ))}
    </div>
    {statistics.some(statistic => statistic.value === null) && <p class="statistics-note">Angka contoh untuk pratinjau desain. Data resmi kepengurusan 2026/2027 akan diperbarui setelah dikonfirmasi.</p>}
  </div>
</section>
