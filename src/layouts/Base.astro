---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
interface Props { title?: string; description?: string; }
const { title = site.name, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ff9f43" />
    <meta property="og:title" content={`${title} | ${site.school}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {site.school}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Langsung ke konten</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
    <script>
      import '../scripts/content';
    </script>
    <script>
      console.log('%cSTOP', 'color: #ed4245; font-size: 80px; font-weight: 900; line-height: 1.1;');
      console.log('Before you do anything, just so you know. Brother is watching -Nixxie');
    </script>
  </body>
</html>
