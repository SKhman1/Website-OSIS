# Local development only. Hosted deployments need a persistent remote database.
DATABASE_URL=file:./data/osis.db
# Set this for a remote libSQL/Turso database; never expose it to the browser.
DATABASE_AUTH_TOKEN=


# Form build flags: only the site key is public. Keep closed until setup is tested.
PUBLIC_ASPIRATIONS_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
# Server/runtime flags. In Pages, configure these as Variables/Secrets.
ASPIRATIONS_ENABLED=false
GOOGLE_FORMS_SCRIPT_URL=
GOOGLE_FORMS_SHARED_SECRET=
TURNSTILE_SECRET_KEY=
# Server-only 32-byte hex AES key. Create once; back up privately. Never PUBLIC_.
CMS_MFA_KEY=
