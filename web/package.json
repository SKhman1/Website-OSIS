{
  "name": "osis-dipo-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:cms-dom": "node tests/cms-dom-check.mjs",
    "test:agenda-dom": "node tests/agenda-dom-check.mjs",
    "build:pages": "astro build --config astro.pages.config.mjs",
    "preview:pages": "wrangler pages dev dist-pages --ip 127.0.0.1 --port 8788",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist-pages --project-name vnd-smkdipo1 --branch main"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.5",
    "dotenv": "18.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "26.6.4",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
